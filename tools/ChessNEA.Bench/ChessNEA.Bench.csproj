<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless runner: perft and timing/allocation measurements for ChessNEA.Engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Same runtime setting as the game (ChessNEA.csproj disables tiered compilation). -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Engine\ChessNEA.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ChessNEA.Engine.Tests" />
  </ItemGroup>
</Project>
