<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless diagnostic runner for the original engine code (Phase 0).
       Runs reproductions, a perft count using the engine's own move functions,
       and baseline timing/allocation measurements without opening a window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Match the game's runtime configuration (ChessNEA.csproj disables tiered compilation). -->
    <TieredCompilation>false</TieredCompilation>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ChessNEA.csproj" />
  </ItemGroup>
</Project>
